# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (dipakai oleh docker-compose dan backend)
POSTGRES_USER=stepsafe
POSTGRES_PASSWORD=stepsafe123
POSTGRES_DB=stepsafe
# Untuk dev lokal tanpa Docker Compose (port 5432 di localhost):
DATABASE_URL=postgres://stepsafe:stepsafe123@localhost:5432/stepsafe

# Auth (wajib ganti dengan string acak panjang >= 32 karakter di STB)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# External API
USER_AGENT=TugasBesar-TST/1.0 (kelompok-MaturXiexie-K01)

# Cloudflare Tunnel (isi di STB dari one.dash.cloudflare.com, jangan di-commit)
TUNNEL_TOKEN=
